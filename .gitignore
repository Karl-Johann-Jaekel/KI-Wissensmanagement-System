# --- Secrets & data (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Data zones — corpus PDFs + private docs never enter git (see PLAN §2, §5).
# Only the top-level data/ dir is kept (via .gitkeep); fetch/ingest scripts create
# data/corpus/ and data/private/ at runtime.
/data/**
!/data/.gitkeep

# n8n credentials / runtime
automation/.n8n/
*.n8n.credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
# generated by scripts/export_graph_json.py (deploy-time), not committed
frontend/public/graph.json
*.local

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Ollama / models (local only) ---
/models/
ollama_data/
