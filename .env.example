# =========================================================================
# KI-Wissensmanagement-System — example environment
# Copy to .env and fill in. .env is git-ignored (see PLAN §2 leitplanken).
# =========================================================================

# --- Runtime ---
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=kwms
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=kwms
POSTGRES_HOST=postgres              # service name in docker-compose network
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432             # host port that maps to Postgres; raise if 5432 is taken
# Full URL is derived from the parts above in core/config.py; override if needed:
# DATABASE_URL=postgresql+psycopg://kwms:change-me@postgres:5432/kwms

# --- Embedding model (ONE model for index AND query; must be multilingual) ---
# Fixed in Phase 3 (see docs/adr/0002). 1024-dim -> matches chunks.embedding VECTOR(1024).
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024

# --- Ollama (local / confidential zone) ---
# In docker-compose the backend defaults to the host's Ollama (host.docker.internal).
# Set to http://ollama:11434 to use the compose `ollama` service (profile: local).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:latest

# --- Reranker (Phase 4) ---
RERANK_ENABLED=false
RERANK_MODEL=bge-reranker-v2-m3

# --- Mistral La Plateforme (public zone, EU-API) — Phase 5 ---
# Pflicht: an diesem Schluessel haengen die Embeddings (EMBED_PROVIDER=mistral),
# auch wenn die Antworten von Groq kommen. Groq hat keinen Embedding-Endpunkt.
# mistral-small-latest kostet rund ein Zehntel von mistral-medium-latest und
# reicht fuer belegte Antworten aus dem Korpus.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# --- Groq (ADR-0021) ---
# Optional. Mit Schluessel antwortet Groq und Mistral wird zur Rueckfallebene.
# Der freie Tarif ist eng getaktet (8000 Token je Minute); eine RAG-Antwort kostet
# grob 2000 bis 4000 Token. RATE_LIMIT deshalb unter Groqs Takt halten, sonst
# produziert die eigene Seite die 429er.
# Modellliste je Konto gegenpruefen, sie weicht von der Doku ab — llama-3.3-70b
# ist dort Produktionsmodell, auf einem freien Konto aber 404:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- API hardening (Phase 5) ---
ADMIN_API_KEY=change-me
DAILY_TOKEN_CAP=200000
RATE_LIMIT=30/minute

# Schreibwege (POST /ingest, PUT /documents/{id}/content, DELETE /documents/{id}).
# In Produktion aus: die Oberflaeche bietet sie nicht an, und ein einzelner Schluessel
# ist zu wenig Schutz fuer einen oeffentlichen Server (ADR-0024). Lokal auf true
# setzen, wenn ueber HTTP befuellt werden soll; sonst `python -m app.ingest`.
WRITES_ENABLED=false

# Netz, aus dem dem X-Forwarded-For geglaubt wird (nur docker-compose.prod.yml).
# Muss das Compose-Netz treffen, sonst faellt das Rate-Limit auf die Caddy-IP
# zusammen und ein Besucher sperrt alle aus. Der Default deckt Dockers
# Standard-Pool ab; abweichenden Pool pruefen mit:
#   docker network inspect <projekt>_default --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Kein "*": sobald Port 8000 doch einmal veroeffentlicht wird, waere der
# Limit-Schluessel frei faelschbar.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Quellen-Harvester (Phase 11.3, ADR-0018) ---
# OpenReview verlangt seit 2026 ein Konto: anonyme Zugriffe beantwortet der Dienst
# mit einer Browser-Challenge. Ein Konto ist kostenlos; arXiv braucht nichts davon.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# --- GROBID (Phase 11.4, ADR-0019) ---
# Profil starten: docker compose --profile grobid up -d
# Vom Host aus (statt aus dem Backend-Container): http://localhost:8070
GROBID_URL=http://grobid:8070
GROBID_HOST_PORT=8070
